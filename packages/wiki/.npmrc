# npm registry for standalone (Docker / OCP) builds.
# All packages are standard npmjs.org packages served via the artifactory mirror.
# No @mybcabisnis scoped packages in this standalone build — no credentials needed.
# This file is ignored by bun (bun reads the root bunfig.toml + root .npmrc instead).
registry=https://artifactory.intra.bca.co.id/artifactory/api/npm/registry.npmjs.org
strict-ssl=false
cafile=ca-bundle.crt
noproxy[]=artifactory.intra.bca.co.id
