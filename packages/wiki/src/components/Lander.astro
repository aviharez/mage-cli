---
import { Image } from "astro:assets"
import { getRelativeLocaleUrl } from "astro:i18n"
import tui from "../assets/lander/screenshot.png"
import web from "../assets/web/screenshot.png"

const locale = Astro.currentLocale || "root"
const docsHref = getRelativeLocaleUrl(locale, "docs")
const installHref = getRelativeLocaleUrl(locale, "docs/instalasi")
const installCmd = "irm https://mage.apps.ocpdevgra.dti.co.id/install.ps1 | iex"
---

<div class="lander">
  <header class="hero">
    <div class="hero-copy enter">
      <p class="eyebrow">AI Agentic MDZ</p>
      <h1>Mage ngerti repo kamu. <span>Tinggal bilang mau bikin apa.</span></h1>
      <p class="hero-lede">
        Asisten coding internal yang membawa konteks proyek, GAIA, dan tooling langsung ke terminal.
      </p>
      <div class="hero-actions">
        <a class="action action-primary" href={docsHref}>Buka dokumentasi</a>
        <button class="copy-command" type="button" data-copy={installCmd}>
          <code>{installCmd}</code>
          <span data-copy-label aria-live="polite">Salin installer</span>
        </button>
      </div>
    </div>
  </header>

  <section class="ledger reveal" aria-labelledby="value-title">
    <div class="section-intro">
      <h2 id="value-title">Dari instruksi ke perubahan yang bisa direview.</h2>
      <p>Mage menjaga alur kerja tetap dekat dengan kode, bukan berpindah-pindah alat.</p>
    </div>

    <dl class="value-list">
      <div>
        <dt>Konteks proyek</dt>
        <dd>Membaca struktur repo, pemanggil fungsi, dan file terkait sebelum mengubah kode.</dd>
      </div>
      <div>
        <dt>GAIA On Prem</dt>
        <dd>Model on prem GAIA membuat code tidak akan ter-expose keluar.</dd>
      </div>
      <div>
        <dt>TUI dan Web</dt>
        <dd>Mulai dari terminal, lanjutkan sesi yang sama di browser saat butuh ruang visual.</dd>
      </div>
      <div>
        <dt>Perintah singkat</dt>
        <dd>Gunakan slash command untuk pekerjaan berulang tanpa merangkai prompt dari awal.</dd>
      </div>
    </dl>
  </section>

  <section class="surfaces reveal" aria-labelledby="surfaces-title">
    <div class="surface-copy">
      <h2 id="surfaces-title">Tetap fokus saat pekerjaan berubah bentuk.</h2>
      <p>Gunakan TUI untuk kecepatan. Buka Web untuk membaca percakapan, perubahan, dan hasil dalam ruang yang lebih luas.</p>
      <a class="text-link" href={getRelativeLocaleUrl(locale, "docs/tui")}>Lihat cara menggunakan Mage</a>
    </div>

    <div class="surface-gallery">
      <figure class="surface surface-tui">
        <div class="surface-frame surface-frame-tui">
          <Image class="surface-image" src={tui} alt="Sesi coding Mage di terminal." loading="lazy" widths={[720, 1080, 1440]} sizes="(max-width: 767px) calc(100vw - 32px), 58vw" />
        </div>
        <figcaption>TUI</figcaption>
      </figure>
      <figure class="surface surface-web">
        <div class="surface-frame">
          <Image class="surface-image" src={web} alt="Sesi Mage dalam tampilan web dengan panel review." loading="lazy" widths={[720, 1080, 1440]} sizes="(max-width: 767px) calc(100vw - 32px), 58vw" />
        </div>
        <figcaption>Web</figcaption>
      </figure>
    </div>
  </section>

  <section class="quickstart reveal" aria-labelledby="quickstart-title">
    <div class="quickstart-head">
      <p class="eyebrow">Mulai cepat</p>
      <h2 id="quickstart-title">Tiga langkah menuju prompt pertama.</h2>
      <a class="text-link" href={installHref}>Baca panduan instalasi</a>
    </div>

    <ol class="path">
      <li>
        <span>Instal</span>
        <p>Jalankan installer untuk sistem operasi Anda.</p>
        <code>irm ... | iex</code>
      </li>
      <li>
        <span>Hubungkan</span>
        <p>Masukkan udomain BCA saat wizard setup terbuka.</p>
        <code>mage</code>
      </li>
      <li>
        <span>Kerjakan</span>
        <p>Buka repo, jelaskan hasil yang diinginkan, lalu review perubahan.</p>
        <code>mage</code>
      </li>
    </ol>
  </section>

  <section class="closing reveal" aria-labelledby="closing-title">
    <div class="closing-copy">
      <h2 id="closing-title">Lebih sedikit perpindahan konteks. Lebih banyak pekerjaan selesai.</h2>
      <p>Mulai dari panduan singkat, lalu bawa Mage ke repo yang sedang Anda kerjakan.</p>
      <a class="action action-primary" href={docsHref}>Buka dokumentasi</a>
    </div>

    <div class="faq">
      <details>
        <summary>Apakah Mage aman untuk kode internal?</summary>
        <p>Mage menggunakan GAIA On Prem sehingga code tidak akan ter-expose keluar.</p>
      </details>
      <details>
        <summary>Apakah Mage tersedia di luar terminal?</summary>
        <p>Ya. Sesi dapat dibuka melalui tampilan Web saat Anda membutuhkan panel percakapan dan review yang lebih luas.</p>
      </details>
      <details>
        <summary>Platform apa yang didukung?</summary>
        <p>Tersedia installer Windows serta panduan macOS dan Linux di halaman instalasi.</p>
      </details>
    </div>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", () => {
      navigator.clipboard.writeText(button.dataset.copy || "").then(() => {
        const label = button.querySelector<HTMLElement>("[data-copy-label]")
        if (label) label.textContent = "Disalin"
        window.setTimeout(() => {
          if (label) label.textContent = "Salin installer"
        }, 1600)
      })
    })
  })
</script>

<style>
  .lander {
    width: 100%;
    overflow: clip;
    color: var(--mg-text);
  }

  .hero,
  .ledger,
  .surfaces,
  .quickstart,
  .closing {
    width: min(100% - 40px, 1280px);
    margin-inline: auto;
  }

  .hero {
    position: relative;
    min-height: calc(100dvh - var(--sl-nav-height, 3.5rem));
    padding: clamp(40px, 7vh, 76px) 0;
    display: flex;
    align-items: center;
  }

  .hero::before,
  .hero::after {
    position: absolute;
    color: var(--mg-accent-bright);
    font-family: var(--mg-font-display);
    line-height: 1;
    pointer-events: none;
  }

  .hero::before {
    content: "✦";
    top: 16%;
    right: 8%;
    font-size: clamp(84px, 9vw, 132px);
    transform: rotate(12deg);
    opacity: .88;
  }

  .hero::after {
    content: "✧";
    top: 53%;
    right: 1%;
    font-size: clamp(44px, 5vw, 68px);
    transform: rotate(-16deg);
    opacity: .48;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    width: min(100%, 1160px);
    margin-left: clamp(0px, 4vw, 64px);
  }

  .eyebrow {
    margin: 0 0 20px;
    font-family: var(--mg-font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--mg-accent-bright);
  }

  .hero h1,
  .lander h2 {
    font-family: var(--mg-font-display);
    color: var(--mg-text);
    text-wrap: balance;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(58px, 7.4vw, 106px);
    line-height: .93;
    letter-spacing: -.06em;
    font-weight: 720;
  }

  .hero h1 span {
    color: var(--mg-accent-bright);
  }

  .hero-lede {
    max-width: 54ch;
    margin: 26px 0 0;
    color: var(--mg-text-muted);
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: stretch;
    gap: 10px;
    margin-top: 32px;
    max-width: 780px;
    min-width: 0;
  }

  .action,
  .copy-command {
    min-height: 44px;
    border-radius: 2px;
    transition: transform .15s ease, border-color .15s ease, background .15s ease;
  }

  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 650;
    text-decoration: none !important;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .action-primary {
    color: var(--mg-bg) !important;
    background: var(--mg-accent-bright);
    border-color: var(--mg-accent-bright);
  }

  .action:hover,
  .copy-command:hover {
    transform: translateY(-1px);
  }

  .action:active,
  .copy-command:active {
    transform: translateY(1px);
  }

  .copy-command {
    min-width: 0;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 8px 12px;
    background: var(--mg-bg-elev);
    color: var(--mg-text-muted);
    border: 1px solid var(--mg-border-strong);
    cursor: pointer;
  }

  .copy-command code {
    overflow: hidden;
    color: var(--mg-text-muted);
    font-family: var(--mg-font-mono);
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-command span {
    color: var(--mg-accent-bright);
    font-family: var(--mg-font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ledger,
  .surfaces,
  .quickstart,
  .closing {
    padding-block: clamp(84px, 11vw, 150px);
    border-top: 1px solid var(--mg-border);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, .75fr);
    gap: 52px;
    align-items: end;
    max-width: 1000px;
  }

  .lander h2 {
    margin: 0;
    font-size: clamp(36px, 5vw, 66px);
    line-height: 1.02;
    letter-spacing: -.045em;
    font-weight: 700;
  }

  .section-intro p,
  .surface-copy p,
  .closing-copy p {
    margin: 0;
    color: var(--mg-text-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .value-list {
    margin: clamp(56px, 7vw, 88px) 0 0 22%;
  }

  .value-list > div {
    display: grid;
    grid-template-columns: minmax(160px, .55fr) minmax(0, 1fr);
    gap: 32px;
    padding: 24px 0;
    border-top: 1px solid var(--mg-border);
  }

  .value-list > div:last-child {
    border-bottom: 1px solid var(--mg-border);
  }

  .value-list dt {
    color: var(--mg-text);
    font-family: var(--mg-font-mono);
    font-size: 13px;
    font-weight: 600;
  }

  .value-list dd {
    margin: 0;
    max-width: 58ch;
    color: var(--mg-text-muted);
    line-height: 1.6;
  }

  .surfaces {
    display: grid;
    grid-template-columns: minmax(280px, .7fr) minmax(0, 1.3fr);
    gap: clamp(44px, 7vw, 100px);
    align-items: start;
  }

  .surface-copy {
    position: sticky;
    top: calc(var(--sl-nav-height, 3.5rem) + 42px);
  }

  .surface-copy p {
    max-width: 45ch;
    margin-top: 24px;
  }

  .text-link {
    display: inline-block;
    margin-top: 24px;
    color: var(--mg-accent-bright) !important;
    font-family: var(--mg-font-mono);
    font-size: 12px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .surface-gallery {
    display: grid;
    gap: 36px;
  }

  .surface {
    min-width: 0;
    margin: 0;
  }

  .surface-frame {
    overflow: hidden;
    border: 1px solid var(--mg-border-strong);
    background: var(--mg-bg-code);
  }

  .surface-frame-tui {
    aspect-ratio: 7 / 5;
    padding: 24px;
  }

  .surface-frame :global(.surface-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .surface figcaption {
    margin-top: 10px;
    color: var(--mg-text-dim);
    font-family: var(--mg-font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .quickstart-head {
    max-width: 760px;
  }

  .quickstart-head .text-link {
    margin-top: 20px;
  }

  .path {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1.35fr;
    margin: clamp(50px, 7vw, 84px) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: path;
    border-top: 1px solid var(--mg-border-strong);
  }

  .path li {
    counter-increment: path;
    min-height: 240px;
    padding: 28px 28px 24px 0;
    border-right: 1px solid var(--mg-border);
  }

  .path li + li {
    padding-left: 28px;
  }

  .path li:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .path li::before {
    content: "0" counter(path);
    display: block;
    margin-bottom: 54px;
    color: var(--mg-accent-bright);
    font-family: var(--mg-font-mono);
    font-size: 11px;
  }

  .path span {
    color: var(--mg-text);
    font-size: 19px;
    font-weight: 650;
  }

  .path p {
    min-height: 52px;
    margin: 12px 0 22px;
    color: var(--mg-text-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .path code {
    color: var(--mg-accent-bright);
    font-family: var(--mg-font-mono);
    font-size: 12px;
  }

  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: start;
  }

  .closing-copy p {
    max-width: 52ch;
    margin-top: 24px;
  }

  .closing-copy .action {
    margin-top: 30px;
  }

  .faq {
    border-top: 1px solid var(--mg-border-strong);
  }

  .faq details {
    padding: 22px 0;
    border-bottom: 1px solid var(--mg-border);
  }

  .faq summary {
    color: var(--mg-text);
    font-weight: 600;
    cursor: pointer;
  }

  .faq p {
    max-width: 58ch;
    margin: 14px 0 0;
    color: var(--mg-text-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .enter {
      animation: enter .75s cubic-bezier(.16, 1, .3, 1) both;
    }

    .reveal {
      animation: reveal linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 34%;
    }
  }

  @keyframes enter {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes reveal {
    from { opacity: .72; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 960px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .surfaces,
    .closing {
      grid-template-columns: 1fr;
    }

    .surface-copy {
      position: static;
    }

    .closing-copy {
      max-width: 760px;
    }
  }

  @media (max-width: 767px) {
    .hero,
    .ledger,
    .surfaces,
    .quickstart,
    .closing {
      width: min(100% - 32px, 1280px);
    }

    .hero {
      min-height: auto;
      padding: 44px 0 72px;
    }

    .hero-copy {
      margin-left: 0;
    }

    .hero::before {
      top: 15%;
      right: -6px;
      font-size: 72px;
      opacity: .42;
    }

    .hero::after {
      display: none;
    }

    .hero h1 {
      font-size: clamp(42px, 12vw, 58px);
      line-height: 1.01;
    }

    .section-intro,
    .value-list > div {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .value-list {
      margin-left: 0;
    }

    .path {
      grid-template-columns: 1fr;
    }

    .path li,
    .path li + li {
      min-height: auto;
      padding: 24px 0;
      border-right: 0;
      border-bottom: 1px solid var(--mg-border);
    }

    .path li::before {
      margin-bottom: 28px;
    }

    .path p {
      min-height: 0;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      width: 100%;
    }

    .copy-command {
      min-height: 50px;
    }

    .lander h2 {
      font-size: 38px;
    }
  }
</style>
