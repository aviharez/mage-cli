---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="site-title" translate="no">
  <span class="wordmark">{siteTitle}</span>
  <span class="descriptor">wiki</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
    color: var(--mg-text, var(--sl-color-text));
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark {
    font-family: var(--mg-font-display, ui-sans-serif, sans-serif);
    font-size: 20px;
    font-weight: 750;
    letter-spacing: -.045em;
  }

  .descriptor {
    color: var(--mg-accent-bright, var(--sl-color-accent-high));
    font-family: var(--mg-font-mono, ui-monospace, monospace);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
</style>
