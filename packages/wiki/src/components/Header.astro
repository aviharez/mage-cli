---
import appConfig from "../../config.mjs"
import starlightConfig from "virtual:starlight/user-config"
import { getRelativeLocaleUrl } from "astro:i18n"
import Search from "virtual:starlight/components/Search"
import SiteTitle from "virtual:starlight/components/SiteTitle"
import ThemeSelect from "virtual:starlight/components/ThemeSelect"

const path = Astro.url.pathname
const locale = Astro.currentLocale || "root"
const route = Astro.locals.starlightRoute
const t = Astro.locals.t as (key: string, fallback?: string) => string
const headerLinks = (appConfig as any).headerLinks as { name: string; url: string }[]

const shouldRenderSearch =
  starlightConfig.pagefind ||
  starlightConfig.components.Search !== "@astrojs/starlight/components/Search.astro"

function href(url: string) {
  if (url.startsWith("http")) return url
  return getRelativeLocaleUrl(locale, url.replace(/^\//, ""))
}

// A link is "active" when the current path starts with its resolved URL,
// EXCEPT for "/" which would always match — only highlight "/" when we're
// actually on the root (not /hub/ or other sections)
function isActive(url: string): boolean {
  if (url.startsWith("http")) return false
  const resolved = href(url)
  if (resolved === "/" || resolved === "") return path === "/" || path === ""
  return path.startsWith(resolved)
}

// Resolve i18n key or return the string itself as fallback (plain-text name)
function label(name: string): string {
  try { return t(name) } catch { return name }
}
---

<div class="header sl-flex">
  <div class="title-wrapper sl-flex">
    <SiteTitle {...route} />
  </div>

  <nav class="middle-group sl-flex" aria-label="Primary navigation">
    {headerLinks?.map(({ name, url }) => (
      <a
        class:list={["links", { active: isActive(url) }]}
        href={href(url)}
        {...(url.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      >{label(name)}</a>
    ))}
  </nav>

  <div class="sl-hidden md:sl-flex right-group">
    {shouldRenderSearch && <Search {...route} />}
    <ThemeSelect {...route} />
  </div>
</div>

<style>
  /* Flat flex matching reference .nav:
     [brand] [links…]          [search] [toggle] [gh] [lang] */
  .header {
    gap: 0;
    justify-content: flex-start;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: calc(0.25rem + 2px) 0.25rem calc(0.25rem - 2px);
    margin: -0.25rem;
    flex-shrink: 0;
  }

  .middle-group {
    display: none;
    align-items: center;
    gap: 2px;
    margin-left: 20px;
  }

  .right-group {
    gap: 6px;
    align-items: center;
  }

  /* Nav links — match reference .nav-links a */
  a.links {
    font-family: var(--mg-font-sans, inherit);
    font-size: 13.5px;
    color: var(--mg-text-muted, var(--sl-color-text-secondary));
    text-transform: none;
    text-decoration: none;
    display: inline-flex;
    padding: 6px 10px;
    border-radius: var(--mg-radius-sm, 4px);
    border-bottom: none !important;
    white-space: nowrap;
  }
  a.links:hover {
    color: var(--mg-text, var(--sl-color-white));
    background: var(--mg-bg-elev, var(--sl-color-gray-1));
    text-decoration: none;
    border-bottom: none !important;
  }
  a.links.active {
    color: var(--mg-text, var(--sl-color-white));
  }

  /* Reference nav is a flat flex row — no grid, no sidebar-aligned offset.
     The brand + links are left-anchored; search/icons are pushed right. */
  @media (min-width: 50rem) {
    .middle-group {
      display: flex;
    }
    .right-group {
      margin-left: auto;
    }
  }
</style>
