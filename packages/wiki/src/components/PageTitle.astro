---
const { title, description } = Astro.locals.starlightRoute.entry.data
---

<header class="docs-masthead">
  <p class="docs-kicker">Dokumentasi Mage</p>
  <h1 id="_top" class="page-title-h1">{title}</h1>
  {description && <p class="page-lede">{description}</p>}
</header>

<style>
  .docs-masthead {
    padding-bottom: clamp(28px, 4vw, 48px);
    border-bottom: 1px solid var(--mg-border, var(--sl-color-hairline));
  }

  .docs-kicker {
    margin: 0 0 16px;
    color: var(--mg-accent-bright, var(--sl-color-accent-high));
    font-family: var(--mg-font-mono, ui-monospace, monospace);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .page-title-h1 {
    max-width: 14ch;
    margin: 0 !important;
    color: var(--mg-text, var(--sl-color-white)) !important;
    font-family: var(--mg-font-display, ui-sans-serif, sans-serif) !important;
    font-size: clamp(3.25rem, 6vw, 6rem) !important;
    font-weight: 750 !important;
    line-height: .9 !important;
    letter-spacing: -.065em !important;
    text-transform: none !important;
    text-wrap: balance;
  }

  .page-lede {
    max-width: 48ch;
    margin: 24px 0 0;
    color: var(--mg-text-muted, var(--sl-color-gray-6));
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (max-width: 767px) {
    .docs-masthead {
      padding-bottom: 28px;
    }

    .page-title-h1 {
      font-size: clamp(3rem, 15vw, 4.25rem) !important;
    }
  }
</style>
