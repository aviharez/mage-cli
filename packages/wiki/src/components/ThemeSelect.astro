<starlight-theme-toggle>
  <button type="button" aria-label="Ganti tema warna">
    <span aria-hidden="true">Tema</span>
  </button>
</starlight-theme-toggle>

<script>
  const storageKey = "starlight-theme"

  class StarlightThemeToggle extends HTMLElement {
    connectedCallback() {
      this.querySelector("button")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark"
        document.documentElement.dataset.theme = next
        localStorage.setItem(storageKey, next)
      })
    }
  }

  if (!customElements.get("starlight-theme-toggle")) {
    customElements.define("starlight-theme-toggle", StarlightThemeToggle)
  }
</script>

<style>
  button {
    min-height: 32px;
    padding: 0 10px;
    border: 1px solid var(--mg-border, var(--sl-color-hairline));
    border-radius: 2px;
    background: transparent;
    color: var(--mg-text-muted, var(--sl-color-gray-6));
    font-family: var(--mg-font-mono, ui-monospace, monospace);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color .15s ease, border-color .15s ease, transform .15s ease;
  }

  button:hover {
    color: var(--mg-text, var(--sl-color-white));
    border-color: var(--mg-accent-line, var(--sl-color-accent));
  }

  button:active {
    transform: translateY(1px);
  }
</style>
