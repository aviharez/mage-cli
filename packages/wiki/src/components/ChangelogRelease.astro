---
interface Props {
  version: string
  date: string
  dateTime: string
  latest?: boolean
}

const props = Astro.props
const id = `release-${props.version.replaceAll(".", "-")}`
---

<article class:list={["release", { "release-latest": props.latest }]} aria-labelledby={id}>
  <header class="release-meta">
    {props.latest && <span>Terbaru</span>}
    <h2 id={id}>{props.version}</h2>
    <time datetime={props.dateTime}>{props.date}</time>
  </header>
  <div class="release-body">
    <slot />
  </div>
</article>
