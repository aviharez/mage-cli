{
  "name": "@mybcabisnis/mage-electron",
  "version": "1.2.12-alpha1",
  "private": true,
  "description": "Electron desktop runtime for Mage",
  "author": "BCA Bisnis",
  "type": "module",
  "main": "./dist-bundle/main.mjs",
  "dependencies": {
    "@mybcabisnis/mage-web-react": "workspace:*",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.0.0"
  },
  "scripts": {
    "dev": "node ./scripts/electron-dev.mjs",
    "dev:bundled": "MAGE_ELECTRON_USE_BUNDLED_UI=1 node ./scripts/electron-dev.mjs",
    "build:sdk": "bun ../../packages/sdk/js/script/build.ts",
    "build:web-assets": "bun run build:sdk && node ./scripts/build-web-assets.mjs",
    "prepare:mage-cli": "node ./scripts/prepare-mage-cli.mjs",
    "verify:mage-cli": "node ./scripts/verify-mage-cli.mjs --staged",
    "bundle:main": "bun ./scripts/bundle-main.mjs",
    "rebuild:native": "node ./scripts/rebuild-native.mjs",
    "package": "bun run build:web-assets && bun run prepare:mage-cli && bun run bundle:main && bun run rebuild:native && node ./scripts/package.mjs",
    "typecheck": "node --check ./main.mjs && node --check ./preload.mjs && node --check ./mage-cwd.mjs && node --check ./runtime-request-headers.mjs",
    "test": "bun test",
    "generate:macos-icon": "node ./scripts/generate-macos-icon-assets.cjs"
  },
  "build": {
    "appId": "co.id.bca.mage.desktop",
    "productName": "Mage",
    "files": ["dist-bundle/main.mjs", "preload.mjs"],
    "extraResources": [
      { "from": "resources/web-dist", "to": "web-dist" },
      { "from": "resources/icons/icon.ico", "to": "icons/icon.ico" },
      { "from": "resources/mage-cli", "to": "mage-cli" }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "directories": { "buildResources": "resources/icons", "output": "dist" },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "extendInfo": { "CFBundleIconName": "AppIcon" },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": ["nsis"],
      "verifyUpdateCodeSignature": false,
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico"
    },
    "dmg": {
      "sign": false,
      "title": "${productName} ${version}",
      "backgroundColor": "#FFFCF0",
      "iconSize": 100,
      "iconTextSize": 13,
      "window": { "width": 540, "height": 340 },
      "contents": [
        { "x": 180, "y": 140, "type": "file" },
        { "x": 360, "y": 140, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
