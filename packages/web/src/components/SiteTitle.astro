---
import appConfig from '../../config.mjs';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const version = (appConfig as any).version as string | undefined;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <!-- Sparkle icon -->
  <span class="sparkle" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2l1.8 6.6 6.6 1.8-6.6 1.8L12 18.8l-1.8-6.6L3.6 10.4l6.6-1.8z"/>
      <path d="M19 3l.6 2.2 2.2.6-2.2.6L19 8.6l-.6-2.2L16.2 5.8l2.2-.6z" opacity="0.7"/>
    </svg>
  </span>

  <!-- Text wordmark (always shown — reference is text-based, not logo) -->
  <span class="wordmark" translate="no">{siteTitle}</span>

  <!-- Version pill -->
  {version && <span class="brand-tag" aria-hidden="true">{version}</span>}
</a>

<style>
  .site-title {
    align-items: center;
    gap: 7px;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
    color: var(--mg-text, var(--sl-color-text));
  }

  .sparkle {
    color: var(--mg-accent, var(--sl-color-accent));
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .wordmark {
    font-family: "Instrument Serif", Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--mg-text, var(--sl-color-text));
    overflow: hidden;
  }

  .brand-tag {
    margin-left: 2px;
    padding: 2px 6px;
    font-family: var(--mg-font-mono, ui-monospace, monospace);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--mg-text-muted, var(--sl-color-gray-6));
    border: 1px solid var(--mg-border, var(--sl-color-hairline));
    border-radius: 999px;
    line-height: 1.5;
  }
</style>
