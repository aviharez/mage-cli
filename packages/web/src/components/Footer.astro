---
import config from "virtual:starlight/user-config"
import { Icon } from "@astrojs/starlight/components"

const { lang, editUrl, lastUpdated, entry } = Astro.locals.starlightRoute
const template = entry.data.template
const issueLink = Astro.locals.t("app.footer.issueLink", "Temukan bug? Buka isu")

const github = config.social?.find((item) => item.icon === "github")
const changelogUrl = "/changelog/"
---

{/* ── Doc meta (edit link / last-updated) — only on doc pages ── */}
{template === "doc" && (
  <footer class="doc-meta">
    <div class="meta sl-flex">
      <div>
        {editUrl && (
          <a href={editUrl} target="_blank" rel="noopener noreferrer" class="sl-flex">
            <Icon name="pencil" size="1em" />
            {Astro.locals.t("page.editLink")}
          </a>
        )}
        {github && (
          <a href={`${github.href}/issues/new`} target="_blank" rel="noopener noreferrer" class="sl-flex">
            <Icon name={github.icon} size="1em" />
            {issueLink}
          </a>
        )}
      </div>
      <div>
        <p>
          <em style="font-family:'Instrument Serif',Georgia,serif;">mage</em>
          {" · "}a fork of{" "}
          <a href="https://opencode.ai" target="_blank" rel="noopener noreferrer">OpenCode</a>
        </p>
        <p title={Astro.locals.t("page.lastUpdated")}>
          {Astro.locals.t("page.lastUpdated")}{" "}
          {lastUpdated ? (
            <time datetime={lastUpdated.toISOString()}>
              {lastUpdated.toLocaleDateString(lang, { dateStyle: "medium", timeZone: "UTC" })}
            </time>
          ) : "-"}
        </p>
      </div>
    </div>
  </footer>
)}

{/* ── Minimal global footer bar — on every page ── */}
<footer class="site-footer">
  <span class="sf-sparkle" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2l1.8 6.6 6.6 1.8-6.6 1.8L12 18.8l-1.8-6.6L3.6 10.4l6.6-1.8z"/>
    </svg>
  </span>
  <span>
    <em style="font-family:'Instrument Serif',Georgia,serif;">mage</em>
    {" · "}a fork of OpenCode
  </span>
  <span class="sf-spacer"></span>
  <a href={changelogUrl}>Perubahan</a>
  {github && (
    <a href={github.href} target="_blank" rel="noopener noreferrer">GitHub</a>
  )}
</footer>

<style>
  /* ── Doc meta block ── */
  footer.doc-meta {
    border-top: 1px solid var(--mg-border, var(--sl-color-hairline));
    margin-top: 2rem;
  }

  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-block: 2rem 1rem;
    font-size: var(--sl-text-sm, 0.875rem);
  }

  @media (min-width: 30rem) {
    .meta {
      flex-direction: row;
    }
  }

  .doc-meta a,
  .doc-meta p {
    padding-block: 0.125rem;
  }

  .doc-meta a {
    gap: 0.4375rem;
    align-items: center;
    text-decoration: none;
    color: var(--mg-text-muted, var(--sl-color-text)) !important;
    font-size: var(--sl-text-sm, 0.875rem);
    border-bottom: none !important;
  }
  .doc-meta a:hover {
    color: var(--mg-accent-bright, var(--sl-color-text-accent)) !important;
    border-bottom: none !important;
  }
  .doc-meta a svg {
    opacity: 0.75;
  }
  .doc-meta p {
    color: var(--mg-text-dim, var(--sl-color-gray-5));
    margin: 0;
  }
  .doc-meta p a {
    color: var(--mg-text-muted, var(--sl-color-gray-5)) !important;
    border-bottom: none !important;
  }
  .doc-meta p a:hover {
    color: var(--mg-accent-bright) !important;
  }
  .doc-meta :global(starlight-lang-select) {
    display: inline-flex;
    margin-top: 0.5rem;
  }
  .doc-meta :global(starlight-lang-select select) {
    min-width: 15em;
  }
  @media (min-width: 30rem) {
    .doc-meta p {
      text-align: right;
    }
  }

  /* ── Global footer bar ── */
  footer.site-footer {
    border-top: 1px solid var(--mg-border, var(--sl-color-hairline));
    margin-top: 2rem;
    padding: 28px 0;
    color: var(--mg-text-dim, var(--sl-color-gray-5));
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .sf-sparkle {
    color: var(--mg-accent, var(--sl-color-accent));
    display: inline-flex;
    flex-shrink: 0;
  }

  .sf-spacer {
    flex: 1;
  }

  footer.site-footer a {
    color: var(--mg-text-dim, var(--sl-color-gray-5)) !important;
    text-decoration: none !important;
    border-bottom: none !important;
  }
  footer.site-footer a:hover {
    color: var(--mg-text, var(--sl-color-white)) !important;
    border-bottom: none !important;
  }

  @media (max-width: 480px) {
    footer.site-footer {
      padding: 20px 0;
      gap: 16px;
    }
    .sf-spacer {
      display: none;
    }
  }
</style>
