#!/usr/bin/env bash
# Mage installer — macOS & Linux
# Usage: curl -fsSL https://mage.apps.ocpdevgra.dti.co.id/install | bash
set -euo pipefail

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
GREEN='\033[0;32m'
NC='\033[0m'

REGISTRY="https://artifactory.intra.bca.co.id/artifactory/api/npm/MBB-Registry-npm/"
PACKAGE="@mybcabisnis/mage"

usage() {
    cat <<EOF
Mage Installer

Usage: install.sh [options]

Options:
    -h, --help               Display this help message
    -v, --version <version>  Install a specific version (e.g. 1.2.2)
        --no-config          Skip .npmrc configuration (assumes registry is already configured)

One-liner:
    curl -fsSL https://mage.apps.ocpdevgra.dti.co.id/install | bash

With a version pin:
    curl -fsSL https://mage.apps.ocpdevgra.dti.co.id/install | bash -s -- --version 1.2.2

From a local copy:
    bash install.sh
    bash install.sh --version 1.2.2
EOF
}

requested_version="${MAGE_VERSION:-}"
no_config=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="${2#v}"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}" >&2
                exit 1
            fi
            ;;
        --no-config)
            no_config=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

# ── 1. Prerequisites ────────────────────────────────────────────────────────

if ! command -v node >/dev/null 2>&1; then
    echo -e "${RED}Error: Node.js is not installed or not on PATH.${NC}"
    echo -e "${MUTED}Mage requires Node.js ≥ 18. Download it from:${NC}"
    echo -e "  https://nodejs.org/en/download"
    exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
    echo -e "${RED}Error: npm is not installed or not on PATH.${NC}"
    echo -e "${MUTED}npm ships with Node.js. Download it from:${NC}"
    echo -e "  https://nodejs.org/en/download"
    exit 1
fi

node_ver=$(node --version 2>/dev/null | sed 's/^v//')
node_major="${node_ver%%.*}"
if [[ "$node_major" -lt 18 ]]; then
    echo -e "${ORANGE}Warning: Node.js $node_ver detected; Mage recommends Node ≥ 18.${NC}"
    echo -e "${MUTED}Upgrade at https://nodejs.org/en/download${NC}"
fi

# ── 2. Configure ~/.npmrc (idempotent) ──────────────────────────────────────

if [[ "$no_config" != "true" ]]; then
    NPMRC="$HOME/.npmrc"
    MARKER_START="# >>> mage >>>"
    MARKER_END="# <<< mage <<<"

    BLOCK="${MARKER_START}
@mybcabisnis:registry=${REGISTRY}
noproxy[]=artifactory.intra.bca.co.id
strict-ssl=false
//artifactory.intra.bca.co.id/artifactory/api/npm/MBB-Registry-npm/:_auth=dXNlcm1iYjpCY2FiY2ExMjM=
${MARKER_END}"

    # Strip any existing managed block so re-runs don't duplicate it
    if [ -f "$NPMRC" ]; then
        awk "/^# >>> mage >>>/{skip=1} !skip{print} /^# <<< mage <<</{skip=0}" \
            "$NPMRC" > "${NPMRC}.mage-tmp"
        mv "${NPMRC}.mage-tmp" "$NPMRC"
    fi

    # Append the fresh managed block
    printf '\n%s\n' "$BLOCK" >> "$NPMRC"

    echo -e "${MUTED}Artifactory registry configured in ${NC}$NPMRC"
fi

# ── 3. Install ──────────────────────────────────────────────────────────────

if [[ -n "$requested_version" ]]; then
    pkg="${PACKAGE}@${requested_version}"
else
    pkg="${PACKAGE}"
fi

echo -e "\n${MUTED}Installing ${NC}${pkg}${MUTED} …${NC}\n"
npm install -g "$pkg"

# ── 4. Verify & banner ──────────────────────────────────────────────────────

installed_version=""
if command -v mage >/dev/null 2>&1; then
    installed_version=$(mage --version 2>/dev/null || true)
fi

if [[ -n "$installed_version" ]]; then
    echo -e "${GREEN}✓ Mage ${installed_version} installed successfully${NC}"
    echo -e ""
    echo -e "${MUTED}Get started:${NC}"
    echo -e ""
    echo -e "  cd <your-project>"
    echo -e "  mage"
    echo -e ""
else
    echo -e "${GREEN}✓ Mage installed${NC}"
    echo -e ""
    npm_bin="$(npm prefix -g 2>/dev/null)/bin"
    echo -e "${ORANGE}Note: 'mage' was not found on PATH.${NC}"
    echo -e "${MUTED}Add the npm global bin directory to your shell config:${NC}"
    echo -e ""
    echo -e "  export PATH=\"${npm_bin}:\$PATH\""
    echo -e ""
    echo -e "${MUTED}Then restart your terminal and run:${NC}  mage"
    echo -e ""
fi
