{
  "$schema": "https://mage.ai/config.json",
  "model": "merlin/qwen3",
  "provider": {
    "merlin": {
      "name": "GAIA",
      "api": "https://gaia-gateway-multimodal-uat.apps.ocpuatgra.dti.co.id/llm-gateway/multimodal",
      "npm": "@mage/merlin-provider",
      "options": {
        "clientId": "MYBCADEV01211231",
        "timeoutMs": 600000
      },
      "models": {
        "qwen3": {
          "name": "Qwen3-30B",
          "release_date": "2025-05-01",
          "temperature": true,
          "attachment": false,
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 99999999,
            "output": 99999999
          }
        },
        "deepseek": {
          "name": "DeepSeek R1",
          "release_date": "2025-01-20",
          "temperature": true,
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 99999999,
            "output": 99999999
          }
        },
        "gemini": {
          "name": "Gemini 2.5 Flash",
          "release_date": "2025-05-20",
          "temperature": true,
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 99999999,
            "output": 99999999
          }
        }
      }
    }
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny"
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
