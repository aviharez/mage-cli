# JFrog Artifactory registry for @snz scoped packages.
# Replace YOUR_COMPANY with your actual JFrog instance hostname.
# Set JFROG_TOKEN as an environment variable or CI/CD secret — never commit the token.
#
# To authenticate locally:
#   export JFROG_TOKEN=<your-api-key-or-identity-token>
#
# To generate a token in JFrog:
#   Profile → Edit Profile → Identity Tokens → Generate Token

@mybcabisnis:registry=https://artifactory.intra.bca.co.id/artifactory/api/npm/MBB-Registry-npm/
noproxy[]=artifactory.intra.bca.co.id
strict-ssl=false
