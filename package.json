{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mage",
  "description": "AI-powered development tool for MDZ",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "MAGE_GAIA_DEBUG_MODE=1 bun run --cwd packages/mage --conditions=browser src/index.ts",
    "dev:serve": "MAGE_CONFIG_DIR=$PWD/packages/mage/defaults bun run --cwd packages/mage --conditions=browser src/index.ts serve --port 4096",
    "dev:app": "bun --cwd packages/web-react dev",
    "dev:app:server": "MAGE_SKIP_START=true MAGE_INTERNAL_PORT=4096 bun --cwd packages/web-react dev:server:watch",
    "vscode:dev": "bun --cwd packages/vscode-react dev",
    "vscode:build": "bun --cwd packages/vscode-react build",
    "vscode:package": "bun --cwd packages/vscode-react package",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "hello": "echo 'Hello World!'",
    "test": "echo 'do not run tests from root' && exit 1",
    "build:plugin": "bun run --cwd packages/plugin build",
    "build:mage": "bun run --cwd packages/mage build",
    "build:release": "bun script/build-release.ts",
    "publish:mage": "bun run --cwd packages/mage publish",
    "publish:release": "bun script/publish.ts",
    "version:set": "bun script/version.ts"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/sdk/js"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-beta.83",
      "@effect/platform-node": "4.0.0-beta.83",
      "@effect/sql-sqlite-bun": "4.0.0-beta.83",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@hono/zod-validator": "0.4.2",
      "@opentui/core": "0.4.3",
      "@opentui/keymap": "0.4.3",
      "@opentui/solid": "0.4.3",
      "opentui-spinner": "0.0.7",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.11",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.1.0-beta.18",
      "@solid-primitives/storage": "4.3.3",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.2",
      "dompurify": "3.3.1",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.83",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "@shikijs/stream": "4.2.0",
      "remend": "1.3.0",
      "@playwright/test": "1.59.1",
      "semver": "7.7.4",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.4.3",
      "remeda": "2.26.0",
      "shiki": "3.20.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.1.11",
      "virtua": "0.49.1",
      "vite": "7.1.4",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "@sentry/solid": "10.36.0",
      "@sentry/vite-plugin": "4.6.0",
      "solid-js": "1.9.10",
      "vite-plugin-solid": "2.11.10",
      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tsconfig/bun": "catalog:",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/mime-types": "3.0.1",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "glob": "13.0.5",
    "globals": "^16.3.0",
    "husky": "9.1.7",
    "node-addon-api": "7.1.1",
    "nodemon": "^3.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "patch-package": "^8.0.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "sharp": "^0.35.0",
    "sst": "4.13.1",
    "tsx": "^4.20.6",
    "turbo": "2.8.13",
    "tw-animate-css": "^1.3.8",
    "typescript-eslint": "^8.39.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "@mybcabisnis/mage-core": "workspace:*",
    "@mybcabisnis/mage-llm": "workspace:*",
    "@mybcabisnis/mage-plugin": "workspace:*",
    "@mybcabisnis/mage-script": "workspace:*",
    "@mybcabisnis/mage-sdk": "workspace:*",
    "@mybcabisnis/mage-shared": "workspace:*",
    "heap-snapshot-toolkit": "1.1.3",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter",
    "electron"
